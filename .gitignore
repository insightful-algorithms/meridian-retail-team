# Synthetic data output. Regenerated by pipeline/generator from a fixed seed
# (charter section 7.1). Never committed. Anyone who clones the repo runs the
# generator to get identical data.
data/
*.duckdb
*.duckdb.wal
*.parquet
*.csv
!pipeline/generator/**/*.csv

# Python
__pycache__/
*.py[cod]
.venv/
venv/
env/
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/
.mypy_cache/
.ruff_cache/

# dbt build artefacts (pipeline/dbt/profiles.yml is committed: DuckDB, no secrets)
pipeline/dbt/target/
pipeline/dbt/dbt_packages/
pipeline/dbt/logs/
logs/

# Great Expectations local state
pipeline/quality/gx/uncommitted/
pipeline/quality/uncommitted/

# Secrets and local config
.env
*.env
*.pem
*.key

# Editor and OS clutter
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
*.log
